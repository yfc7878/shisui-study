# 运行端口
PORT=8787
HOST=0.0.0.0

# 首次启动的管理员密码（只在 data/app.json 尚未生成时使用）。
# 留空则首次启动自动生成随机密码，并在服务器启动日志中显示一次。
ADMIN_PASSWORD=

# 会话签名密钥；留空会自动生成并保存到 data/app.json
JWT_SECRET=

# 数据库与图片保存目录（Docker 中通常为 /app/data）
DATA_DIR=./server/data

# 允许访问的来源；同源部署可留空。例：https://study.example.com
APP_ORIGIN=

# 反向代理（Cloudflare Tunnel / Nginx）后面设置为 1
TRUST_PROXY=0

# DeepSeek 服务端兜底 Key（可选）。更推荐在前端「设置」里填写，Key 只保存在浏览器 localStorage。
# 设置后，所有设备无需再填写 Key；但请确保 .env 不泄露。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 登录会话天数
SESSION_DAYS=30
